
(rules PCB Jet Ranger Auto Pilot Panel
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 1701)
    (layer_rule F.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.5)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.7)
    )
  )
  (rule
    (width 250.0)
    (clear 200.0)
    (clear 125.0 (type smd_to_turn_gap))
    (clear 50.0 (type smd_smd))
  )
  (padstack "Via[0-1]_800:400_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_800:400_um" "Via[0-1]_800:400_um" default
  )
  (via 
    "Via[0-1]_800:400_um-kicad_default" "Via[0-1]_800:400_um" "kicad_default"
  )
  (via_rule
    default "Via[0-1]_800:400_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_800:400_um-kicad_default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "Net-(D1-K)" "Net-(D2-K)" "Net-(D3-K)" "Net-(D4-K)" GND ROW0 ROW1 +3.3V
    ROW2 ROW3 "/BACKLIGHT_PANELS" "/+12v-IN" COL1 "/CATHODE_00" "/ANNODE_01" "/ANNODE_02"
    "/ANNODE_03" "/ANNODE_00" COL2 "Net-(D9-K)" "Net-(D10-K)" "Net-(D11-K)" "/CATHODE_01" "AP_OLED_SC"
    "AP_OLED_SD" "/VS_B" "/IAS_B" "/CRS_A" "/VS_A" "/HDG_B" "/ALT_A" "/AP_MAG_SWITCH_COIL"
    "/CRS_B" "/HDG_A" "/IAS_A" "/ALT_B" "unconnected-(J3-Pin_30-Pad30)" "unconnected-(J3-Pin_33-Pad33)" "unconnected-(J3-Pin_34-Pad34)" "unconnected-(J3-Pin_31-Pad31)"
    "unconnected-(J3-Pin_32-Pad32)" "Net-(D16-K)"
    (clearance_class "kicad_default")
    (via_rule kicad_default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)