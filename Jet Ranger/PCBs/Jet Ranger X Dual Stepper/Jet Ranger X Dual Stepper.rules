
(rules PCB Jet Ranger X Dual Stepper
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 5413)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.0)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.0)
    )
  )
  (rule
    (width 250.0)
    (clear 200.0)
    (clear 125.0 (type smd_to_turn_gap))
    (clear 50.0 (type smd_smd))
  )
  (padstack "Via[0-1]_600:400_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:400_um" "Via[0-1]_600:400_um" default
  )
  (via 
    "Via[0-1]_600:400_um-kicad_default" "Via[0-1]_600:400_um" "kicad_default"
  )
  (via_rule
    default "Via[0-1]_600:400_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_600:400_um-kicad_default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "Net-(D1-A)" GND "Net-(D2-A)" "Net-(D3-A)" "Net-(D4-A)" "/+5v_IN" "/INT_5V" SCLK
    "/STEPPER_EOP_B" "/STEPPER_FL_D" "/PIN_20" "ES1_RST" "/STEPPER_FL_B" "/STEPPER_ALT_C" MISO "/STEPPER_TS_B"
    "/STEPPER_EL_D" /RESET MOSI "/GREEN_LED" "/RED_LED" SS "/STEPPER_VVI_A" "/BACKLIGHT_PWM"
    "/STEPPER_VVI_C" +3V3 /D1 /D0 /VIN "/STEPPER_EL_C" /AREF "/RESET_pin"
    "/STEPPER_XOT_B" "/STEPPER_TS_C" "/STEPPER_EOT_B" "/STEPPER_EOP_C" "/STEPPER_XOT_C" /IORF "/STEPPER_XOP_B" "/STEPPER_RS_C"
    "/STEPPER_VVI_D" "/STEPPER_RS_D" "/STEPPER_EGT_A" "/STEPPER_XOT_D" "/ZERO-DETECT-ALTIMETER" "/STEPPER_XOT_A" "/STEPPER_EOT_D" "/STEPPER_EGT_B"
    "/STEPPER_ALT_A" "/STEPPER_VVI_B" "/STEPPER_EL_A" "/STEPPER_SPD_A" "/STEPPER_ALT_B" "/STEPPER_XOP_C" "/STEPPER_FL_C" "/STEPPER_EOT_C"
    "/STEPPER_ALT_D" "/PIN_21" "Net-(D5-A)" "/STEPPER_RS_A" "/+5v_SERVO" "/STEPPER_EL_B" "/STEPPER_TS_D" "/STEPPER_XOP_A"
    "/STEPPER_XOP_D" "/STEPPER_EOT_A" "/STEPPER_EOP_D" "/STEPPER_EGT_D" "/STEPPER_SPD_B" "unconnected-(J14-Pin_1-Pad1)" "Net-(Q1-G)" "Net-(U3-INT)"
    "/STEPPER_SPD_C" "/STEPPER_TS_A" "unconnected-(U3-NC-PadB4)" "Net-(J3-Pin_1)" "/STEPPER_SPD_D" "/STEPPER_EGT_C" "/STEPPER_RS_B" "Net-(J15-Pin_11)"
    "BACKLIGHT_-V" +12V "/STEPPER_EOP_A" "/STEPPER_FA_D" "/STEPPER_FL_A" "/STEPPER_FA_B" "/STEPPER_FA_C" "Net-(J15-Pin_3)"
    "Net-(J15-Pin_2)" "Net-(J15-Pin_7)" "Net-(J15-Pin_10)" "Net-(J15-Pin_1)" "Net-(J15-Pin_4)" "Net-(J15-Pin_9)" "Net-(J15-Pin_8)" "Net-(J15-Pin_5)"
    "Net-(J15-Pin_12)" "Net-(J15-Pin_6)" "/I2C_SEL_A0" /SDA "/I2C_SEL_A2" "/I2C_SEL_RESET" /SCL "/I2C_SEL_A1"
    /SD1 /SC1 /SD2 /SC2 /SD4 /SD3 /SD5 /SC5
    /SD0 /SC6 /SC7 /SC0 /SD6 /SC4 /SD7 /SC3
    (clearance_class "kicad_default")
    (via_rule kicad_default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)