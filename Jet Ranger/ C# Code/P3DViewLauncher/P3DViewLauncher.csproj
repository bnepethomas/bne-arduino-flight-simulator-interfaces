<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET Framework, 64 bit: the Prepar3D SimConnect library does not load in modern .NET. -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="LockheedMartin.Prepar3D.SimConnect">
      <!-- Version 4.4 of the library; Prepar3D v5 accepts it and it has the view functions. -->
      <HintPath>lib\LockheedMartin.Prepar3D.SimConnect.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Update="views.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
