<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x64</Platforms>
    <StartupObject>MSFSWinformsAutoCS.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Managed SimConnect wrapper and the native SimConnect.dll from the MSFS 2024 SDK
         (SimConnect SDK\lib), copied into lib\ so the project builds without the SDK path. -->
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>lib\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
    </Reference>
    <None Include="lib\SimConnect.dll" Link="SimConnect.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Version, build number and build date. RAISE BuildNumber BY ONE EVERY TIME THIS PROGRAM IS CHANGED (and Version for a larger change); the build date
       and time are stamped in automatically at every build. Both are shown in the About window. -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <BuildNumber>8</BuildNumber>
    <FileVersion>1.0.0.$(BuildNumber)</FileVersion>
    <BuildDateTime>$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))</BuildDateTime>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>BuildNumber</_Parameter1><_Parameter2>$(BuildNumber)</_Parameter2></AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>BuildDateTime</_Parameter1><_Parameter2>$(BuildDateTime)</_Parameter2></AssemblyAttribute>
  </ItemGroup>

</Project>
