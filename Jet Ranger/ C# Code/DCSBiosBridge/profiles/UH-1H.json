{
  // Bell UH-1H Huey profile (DCS-BIOS module "UH-1H"). The left column is the generic token the Jet Ranger boards understand (LED_H_* are the 20 Huey
  // Warning Panel LEDs on the Radio controller); "control" is the DCS-BIOS control identifier that supplies it. The identifiers (CL_A0 to CL_J1, the
  // "Caution Lights Panel" indicator lights) are from DCS-BIOS v0.11.8, Scripts\DCS-BIOS\lib\modules\aircraft_modules\UH-1H.lua, and match the DCS cockpit
  // arguments 91 to 110 that the 2017 export script read. DCS-BIOS gives them their memory addresses when DCS starts and writes them to
  // Saved Games\DCS\Scripts\DCS-BIOS\doc\json\UH-1H.json, which the bridge reads: start DCS once with DCS-BIOS installed before using this profile.
  // No bus voltage is mapped (DC_VOLTAGE and DC_V are 0 to 1 needle positions with no known voltage scale), so the aircraft counts as powered while data flows.
  "module": "UH-1H",
  "jsonFile": "UH-1H.json",
  "aircraft": [ "UH-1H", "Bell47_2" ],
  "values": [
    { "token": "LED_H_ENG_OIL",          "control": "CL_A0", "hint": "ENGINE OIL PRESS",            "type": "lamp" },
    { "token": "LED_H_ENG_ICE",          "control": "CL_B0", "hint": "ENGINE ICING",                "type": "lamp" },
    { "token": "LED_H_ENG_ICE_DETECT",   "control": "CL_C0", "hint": "ENGINE ICE JET",              "type": "lamp" },
    { "token": "LED_H_ENG_CHIP",         "control": "CL_D0", "hint": "ENGINE CHIP DET",             "type": "lamp" },
    { "token": "LED_H_LEFT_FUEL_BOOST",  "control": "CL_E0", "hint": "LEFT FUEL BOOST",             "type": "lamp" },
    { "token": "LED_H_RIGHT_FUEL_BOOST", "control": "CL_F0", "hint": "RIGHT FUEL BOOST",            "type": "lamp" },
    { "token": "LED_H_ENG_FUEL_PUMP",    "control": "CL_G0", "hint": "ENG FUEL PUMP",               "type": "lamp" },
    { "token": "LED_H_20_MINUTE_FUEL",   "control": "CL_H0", "hint": "20 MIN FUEL",                 "type": "lamp" },
    { "token": "LED_H_FUEL_FILTER",      "control": "CL_I0", "hint": "FUEL FILTER",                 "type": "lamp" },
    { "token": "LED_H_GOV_EMER",         "control": "CL_J0", "hint": "GOV EMER",                    "type": "lamp" },
    { "token": "LED_H_AUX_FUEL_LOW",     "control": "CL_A1", "hint": "AUX FUEL LOW",                "type": "lamp" },
    { "token": "LED_H_XMSN_OIL_PRESS",   "control": "CL_B1", "hint": "XMSN OIL PRESS",              "type": "lamp" },
    { "token": "LED_H_XMSN_OIL_HOT",     "control": "CL_C1", "hint": "XMSN OIL HOT",                "type": "lamp" },
    { "token": "LED_H_HYD_PRESS",        "control": "CL_D1", "hint": "HYD PRESSURE",                "type": "lamp" },
    { "token": "LED_H_ENG_INLET_AIR",    "control": "CL_E1", "hint": "ENGINE INLET AIR",            "type": "lamp" },
    { "token": "LED_H_INST_INVERTER",    "control": "CL_F1", "hint": "INST INVERTER",               "type": "lamp" },
    { "token": "LED_H_DC_GENERATOR",     "control": "CL_G1", "hint": "DC GENERATOR",                "type": "lamp" },
    { "token": "LED_H_EXT_POWER",        "control": "CL_H1", "hint": "EXTERNAL POWER",              "type": "lamp" },
    { "token": "LED_H_CHIP_DETECTOR",    "control": "CL_I1", "hint": "CHIP DETECTOR",               "type": "lamp" },
    { "token": "LED_H_IFF",              "control": "CL_J1", "hint": "IFF",                         "type": "lamp" },

    // Gauges. AGL is exact: the radar altimeter's four drum digits (thousands first). The others are the cockpit gauges' needle POSITIONS (0 to 1 of the dial, which is
    // all DCS-BIOS gives) and have only a first-guess scale: the dial's whole sweep is mapped onto the panel gauge's own range, so the panel needle follows the same
    // fraction of its dial. They show "uncalibrated" in the bridge until you use Calibrate selected... (fly to a reading, type what the cockpit gauge says; two or
    // more points replace the guess; the points are kept in UH-1H.calibration.json). Airspeed, altitude, heading and position are real values from _common.json.
    { "token": "AGL",            "type": "digits", "controls": [ "RALT_DIGIT_1", "RALT_DIGIT_2", "RALT_DIGIT_3", "RALT_DIGIT_4" ], "hint": "radar altimeter drum digits" },
    { "token": "VSI",            "control": "VVI_P",         "type": "analog", "scale": 3500, "offset": -1750, "decimals": 0, "provisional": true, "hint": "vertical velocity pilot, +-1 of the dial = +-1750 ft/min" },
    { "token": "TQ",             "control": "TORQUE_PRESS",  "type": "analog", "scale": 120, "decimals": 0, "provisional": true, "hint": "torque pressure, dial 0-1 = 0-120 percent" },
    { "token": "N1",             "control": "GAS_RPM",       "type": "analog", "scale": 103, "decimals": 0, "provisional": true, "hint": "gas producer RPM, dial 0-1 = 0-103 percent" },
    { "token": "ITT",            "control": "EXHAUST_TEMP",  "type": "analog", "scale": 800, "offset": 100, "decimals": 0, "provisional": true, "hint": "exhaust temperature, dial 0-1 = 100-900 C" },
    { "token": "FUEL",           "control": "FUEL_QTY",      "type": "analog", "scale": 75, "decimals": 0, "provisional": true, "hint": "fuel quantity, dial 0-1 = 0-75 gallons" },
    { "token": "OILP",           "control": "ENG_OIL_PRESS", "type": "analog", "scale": 150, "decimals": 0, "provisional": true, "hint": "engine oil pressure, dial 0-1 = 0-150 psi" },
    { "token": "OILT",           "control": "ENG_OIL_TEMP",  "type": "analog", "scale": 150, "decimals": 0, "provisional": true, "hint": "engine oil temperature, dial 0-1 = 0-150 C" },
    { "token": "XMSNP",          "control": "TRANS_OIL_PRESS", "type": "analog", "scale": 150, "decimals": 0, "provisional": true, "hint": "transmission oil pressure, dial 0-1 = 0-150 psi" },
    { "token": "XMSNT",          "control": "TRANS_OIL_TEMP", "type": "analog", "scale": 150, "decimals": 0, "provisional": true, "hint": "transmission oil temperature, dial 0-1 = 0-150 C" },
    { "token": "RPMR",           "control": "ROTOR_RPM",     "type": "analog", "scale": 110, "decimals": 1, "provisional": true, "hint": "rotor RPM, dial 0-1 = 0-110 percent" },
    { "token": "RPME",           "control": "ENG_RPM",       "type": "analog", "scale": 110, "decimals": 1, "provisional": true, "hint": "engine RPM, dial 0-1 = 0-110 percent" },
    { "token": "ELECTRICALLOAD", "control": "MAIN_GEN_LOAD", "type": "analog", "scale": 100, "decimals": 0, "provisional": true, "hint": "main generator load, dial 0-1 = 0-100 percent" },
    { "token": "FUELLOAD",       "control": "FUEL_PRESS",    "type": "analog", "scale": 30, "decimals": 0, "provisional": true, "hint": "fuel pressure, dial 0-1 = 0-30 psi" },
    { "token": "PITCH",          "control": "PADI_PITCH",    "type": "analog", "scale": 180, "offset": -90, "decimals": 1, "provisional": true, "hint": "pilot ADI pitch, +-1 of the dial = +-90 degrees (sign and scale unchecked)" },
    { "token": "BANK",           "control": "PADI_ROLL",     "type": "analog", "scale": 360, "offset": -180, "decimals": 1, "provisional": true, "hint": "pilot ADI roll, +-1 of the dial = +-180 degrees (sign and scale unchecked)" }
  ]
}
